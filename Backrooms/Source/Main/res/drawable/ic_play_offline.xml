<?xml version="1.0" encoding="utf-8"?>
<!--
    Play triangle in ring — offline play
    Tinted at use site via Compose's ColorFilter, so a single asset serves every
    accent colour. 24dp canvas on a 24-unit viewport keeps path coordinates
    readable and matches the platform icon grid.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:pathData="M12,12 m-8.4,0 a8.4,8.4 0 1,0 16.8,0 a8.4,8.4 0 1,0 -16.8,0" />
    <path android:fillColor="#FFFFFF"
        android:pathData="M9.8,7.9 L16.4,12 L9.8,16.1 Z" />
</vector>
