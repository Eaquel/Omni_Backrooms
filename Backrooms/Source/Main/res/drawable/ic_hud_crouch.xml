<?xml version="1.0" encoding="utf-8"?>
<!--
    Downward chevron under ceiling line — HUD crouch
    Tinted at use site via Compose's ColorFilter, so a single asset serves every
    accent colour. 24dp canvas on a 24-unit viewport keeps path coordinates
    readable and matches the platform icon grid.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">
    <path android:fillColor="#FFFFFF"
        android:pathData="M12,20.6 L17.2,14.4 L6.8,14.4 Z" />
    <path android:strokeColor="#FFFFFF" android:strokeWidth="1.9" android:strokeLineCap="round"
        android:pathData="M12,14.4 L12,6.6" />
    <path android:strokeColor="#FFFFFF" android:strokeWidth="1.6" android:strokeAlpha="0.45"
        android:strokeLineCap="round" android:pathData="M6.2,3.4 L17.8,3.4" />
</vector>
