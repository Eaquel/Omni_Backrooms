<?xml version="1.0" encoding="utf-8"?>
<!--
    Skill node graph — abilities tab
    Tinted at use site via Compose's ColorFilter, so a single asset serves every
    accent colour. 24dp canvas on a 24-unit viewport keeps path coordinates
    readable and matches the platform icon grid.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.2"
        android:strokeAlpha="0.55"
        android:strokeLineCap="round"
        android:pathData="M12,12 L12,5.4 M12,12 L18.2,15.4 M12,12 L5.8,15.4" />
    <path android:fillColor="#FFFFFF" android:pathData="M12,12 m-2.2,0 a2.2,2.2 0 1,0 4.4,0 a2.2,2.2 0 1,0 -4.4,0" />
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.4"
        android:pathData="M12,5.4 m-1.9,0 a1.9,1.9 0 1,0 3.8,0 a1.9,1.9 0 1,0 -3.8,0
                          M18.2,15.4 m-1.9,0 a1.9,1.9 0 1,0 3.8,0 a1.9,1.9 0 1,0 -3.8,0
                          M5.8,15.4 m-1.9,0 a1.9,1.9 0 1,0 3.8,0 a1.9,1.9 0 1,0 -3.8,0" />
</vector>
