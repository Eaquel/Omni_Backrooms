<?xml version="1.0" encoding="utf-8"?>
<!--
    Stopwatch — best survival / countdown
    Tinted at use site via Compose's ColorFilter, so a single asset serves every
    accent colour. 24dp canvas on a 24-unit viewport keeps path coordinates
    readable and matches the platform icon grid.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:pathData="M12,13.6 m-7.2,0 a7.2,7.2 0 1,0 14.4,0 a7.2,7.2 0 1,0 -14.4,0" />
    <path android:strokeColor="#FFFFFF" android:strokeWidth="1.7" android:strokeLineCap="round"
        android:pathData="M12,13.6 L12,9 M12,13.6 L15.2,15.2" />
    <path android:strokeColor="#FFFFFF" android:strokeWidth="1.8" android:strokeLineCap="round"
        android:pathData="M9.6,3.4 L14.4,3.4" />
</vector>
