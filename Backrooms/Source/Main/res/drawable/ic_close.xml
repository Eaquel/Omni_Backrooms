<?xml version="1.0" encoding="utf-8"?>
<!--
    Cross — close
    Tinted at use site via Compose's ColorFilter, so a single asset serves every
    accent colour. 24dp canvas on a 24-unit viewport keeps path coordinates
    readable and matches the platform icon grid.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">
    <path android:strokeColor="#FFFFFF" android:strokeWidth="2" android:strokeLineCap="round"
        android:pathData="M6.6,6.6 L17.4,17.4 M17.4,6.6 L6.6,17.4" />
</vector>
