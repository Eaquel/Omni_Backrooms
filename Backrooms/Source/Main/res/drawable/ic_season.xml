<?xml version="1.0" encoding="utf-8"?>
<!--
    Access badge — season tab

    Was a trophy. A cup on a plinth is a sports award and this game has nothing
    to award one for; it was there because battle passes conventionally use a
    trophy. A laminated pass on a lanyard clip says "season pass" far more
    directly, and it is exactly the object that would be clipped to somebody in
    a building like this one.

    Tinted at the use site via Compose's ColorFilter.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">
    <!-- Lanyard clip. -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.4"
        android:strokeLineCap="round"
        android:pathData="M10.4,4.4 L13.6,4.4" />
    <!-- Card. -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineJoin="round"
        android:pathData="M5.6,6.2 L18.4,6.2 L18.4,20.6 L5.6,20.6 Z" />
    <!-- Punched slot at the top, which is what makes it a pass and not a card. -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.2"
        android:strokeLineJoin="round"
        android:pathData="M10.6,8.0 L13.4,8.0 L13.4,9.2 L10.6,9.2 Z" />
    <!-- Portrait: head and shoulders, kept as a silhouette so it stays legible
         when the whole icon is 24dp across. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12,12.4 m-1.7,0 a1.7,1.7 0 1,0 3.4,0 a1.7,1.7 0 1,0 -3.4,0" />
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.4"
        android:strokeLineCap="round"
        android:pathData="M8.8,18.2 C8.8,15.9 10.2,15.0 12,15.0 C13.8,15.0 15.2,15.9 15.2,18.2" />
</vector>
