<?xml version="1.0" encoding="utf-8"?>
<!--
    Vending machine — market tab

    Was a shopping bag. A high-street carrier bag belongs to a shop, and there
    are no shops here; the vending machine humming alone at the end of a
    corridor is the one piece of commerce this building actually has, and it is
    among the most recognisable objects in the whole genre.

    Reads at 24dp because the silhouette does the work: a tall cabinet with a
    lit window, not a pile of small details. Tinted at the use site via
    Compose's ColorFilter, so one asset serves every accent colour.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">
    <!-- Cabinet. -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineJoin="round"
        android:pathData="M5.4,2.8 L18.6,2.8 L18.6,21.2 L5.4,21.2 Z" />
    <!-- Glass front, inset so the cabinet edge stays legible. -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.2"
        android:strokeAlpha="0.75"
        android:pathData="M7.4,4.8 L14.2,4.8 L14.2,14.4 L7.4,14.4 Z" />
    <!-- Two shelves of stock. -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.1"
        android:strokeAlpha="0.55"
        android:pathData="M7.4,8.0 L14.2,8.0 M7.4,11.2 L14.2,11.2" />
    <!-- Keypad. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M16.0,5.6 m-0.6,0 a0.6,0.6 0 1,0 1.2,0 a0.6,0.6 0 1,0 -1.2,0
                          M16.0,8.0 m-0.6,0 a0.6,0.6 0 1,0 1.2,0 a0.6,0.6 0 1,0 -1.2,0
                          M16.0,10.4 m-0.6,0 a0.6,0.6 0 1,0 1.2,0 a0.6,0.6 0 1,0 -1.2,0" />
    <!-- Dispensing slot. -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.4"
        android:strokeLineJoin="round"
        android:pathData="M7.4,16.8 L16.6,16.8 L16.6,19.0 L7.4,19.0 Z" />
</vector>
